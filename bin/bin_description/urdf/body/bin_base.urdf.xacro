<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
<xacro:property name="base_width" value="0.227" />
<xacro:property name="base_length" value="0.224725" />
<xacro:property name="base_height" value="0.12" />
<!-- <xacro:property name="base_height" value="0.140234" /> -->
<xacro:property name="com_x" value="0.00489" />     <!--Center of Mass-->
<xacro:property name="com_y" value="-0.00007433" /> 
<xacro:property name="com_z" value="0.001" /> 
<xacro:property name="pla_density"        value="1240.0" />
<xacro:property name="metal_density"      value="7850.0" />
<xacro:property name="base_wall_thickness" value="0.004" />
<xacro:property name="base_mass" value="${pla_density * base_wall_thickness * (base_length*base_width + 2*base_width*base_height + 2*base_length*base_height)}" />
<xacro:property name="castor_radius" value="${wheel_radius/2}" />
<xacro:property name="castor_mass" value="${metal_density * (4.0/3.0) * pi * castor_radius * castor_radius * castor_radius}" />



<xacro:macro name="bin_base" params="prefix z_off">
    <link name="${prefix}base_footprint"/>
    <link name="${prefix}base_link">
        <visual>
            <geometry>
                <mesh filename="package://bin_description/meshes/Base.stl" scale="1 1 1"/>
                <!-- <box size="${base_length} ${base_width} ${base_height}"/> -->
            </geometry>
            <!-- <origin xyz="0 0 0" rpy="0 0 0"/> -->
            <origin xyz="-0.01 0 ${base_height}" rpy="0 0 0"/>
            <material name="white">
                <color rgba="1 1 1 0.5"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <!-- <mesh filename="package://bin_description/meshes/Base.stl" scale="1 1 1"/> -->
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="${base_mass}"/>
            <inertia ixx="${(1/12) * base_mass * ((base_width * base_width) + (base_height * base_height))}"  ixy="0.0"  ixz="0.0"  
                     iyy="${(1/12) * base_mass * ((base_length * base_length) + (base_height * base_height))}"  iyz="0.0" 
                     izz="${(1/12) * base_mass * ((base_length * base_length) + (base_width * base_width))}"/>
        </inertial>
    </link>
    <joint name="${prefix}base_joint" type="fixed">
        <parent link="${prefix}base_footprint"/>
        <child link="${prefix}base_link"/>
        <origin xyz="0 0 ${z_off}" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}bin_castor_link">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <!-- <mesh filename="package://bin_description/meshes/Caster Wheel.stl" scale="1 1 1"/> -->
                <sphere radius="${castor_radius}"/>
            </geometry>
            <material name="black">
                <color rgba="0 0 0 0.5"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <!-- <mesh filename="package://bin_description/meshes/Caster Wheel.stl" scale="1 1 1"/> -->
                <sphere radius="${castor_radius}"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="${castor_mass}"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <inertia ixx="${(2/5) * castor_mass * castor_radius * castor_radius}"  ixy="0.0"  ixz="0.0"
                    iyy="${(2/5) * castor_mass * castor_radius * castor_radius}"  iyz="0.0"
                    izz="${(2/5) * castor_mass * castor_radius * castor_radius}"/>
        </inertial>
    </link>

    <joint name="${prefix}base_castor_joint" type="fixed">
        <origin xyz="${-base_length/2} 0.0 ${-castor_radius}" rpy="0.0 0.0 0.0"/>
        <parent link="${prefix}base_link"/>
        <child link="${prefix}bin_castor_link"/>
    </joint>


</xacro:macro>
</robot>